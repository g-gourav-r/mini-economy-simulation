# ==============================================================================
# Supabase Configuration
# ==============================================================================
# 1. NEXT_PUBLIC_SUPABASE_URL: Your Supabase Project URL (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# 2. SUPABASE_SERVICE_ROLE_KEY: The secret Service Role API Key (Settings -> API)
# Keep this secret! Used in Next.js Server API Routes to execute atomic transactions.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-api-key"
